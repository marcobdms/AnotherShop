# Backend publico de Coolify. En local puede quedar vacio para usar el proxy Vite.
VITE_API_URL=

# Backend local usado por el proxy de Vite. Default del repo: http://localhost:8010
VITE_LOCAL_API_URL=

# Token admin visible en el bundle Vite. Proteger este frontend con Vercel/Cloudflare/Coolify auth.
VITE_ADMIN_TOKEN=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
